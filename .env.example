# Copy this file to .env and replace every placeholder with a real value.
# .env is git-ignored and must never be committed.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=frameflow_db
MYSQL_USER=frameflow_app
MYSQL_PASSWORD=replace-with-app-user-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
